# Booking app database. Created by `node scripts/dev-db.mjs`, which also applies
# the drizzle schema to it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tixify_app

# Security engine database. Disjoint from the app's on purpose: the engine owns
# its own telemetry, audit, idempotency and scan tables.
SECURITY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tixify

# Redis backs rate limiting, idempotency, the virtual queue and bot challenges.
# It is started with --maxmemory-policy noeviction because those keys are
# correctness-bearing: evicting an in-flight rate limit silently raises the limit.
REDIS_URL=redis://127.0.0.1:6379

# Signs the session cookie. Replace this with a real secret before deploying;
# the server refuses to authenticate without it.
JWT_SECRET=dev-only-insecure-secret-change-me

# Ticket signing key, as emitted by `pnpm --filter @tixify/security-engine keys:generate`.
# The dev value below is the format the loader expects, not a usable key.
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=
TICKET_SIGNING_KEY_ID=dev-1

# Manus OAuth. Leave blank to run the UI unauthenticated against a local database.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
