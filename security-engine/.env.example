# ==============================================================================
# TIXIFY-VR Security Engine — environment configuration
# ==============================================================================
# Copy to `.env` and fill in real values.  NEVER commit a populated `.env`.
# The file you are reading contains NO real secrets and is safe to commit.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Ed25519 ticket signing keys
# ------------------------------------------------------------------------------
# Generate a key pair with:  npm run keys:generate
#
# The PRIVATE key signs tickets. It must exist ONLY on the server.
# It must NEVER appear in a frontend bundle, a QR code, a log line, or git.
#
# The PUBLIC key verifies tickets and MAY be shared with the verification
# service. Verification needs the public key only.
#
# Format: base64 of the 32-byte raw Ed25519 key (NOT PEM).
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=

# Key id published in every signed envelope so verifiers can select a key.
# Bump this when rotating. See docs/SECURITY_ARCHITECTURE.md section 4.1.
TICKET_SIGNING_KEY_ID=key-1

# Comma-separated list of key ids that are still trusted for VERIFICATION only.
# Populate during rotation so previously issued tickets keep validating.
TICKET_SIGNING_TRUSTED_KEY_IDS=key-1

# Ed25519 keys are valid until this instant. After it, tickets signed by this key
# are rejected outright. Use a far-future value for the current key.
TICKET_SIGNING_RETIRE_AT=2027-01-01T00:00:00.000Z

# Default ticket lifetime. QR payloads embed an absolute expiry.
TICKET_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Redis — required for distributed rate limiting, idempotency and the queue
# ------------------------------------------------------------------------------
# NEVER an in-memory fallback in production: serverless instances do not share
# memory, so an in-process counter is a complete rate-limit bypass.
# Use a managed Redis (Upstash / Redis Cloud) when deploying to Vercel.
REDIS_URL=redis://localhost:6379

# Namespace prefix so the security engine can share a Redis instance safely.
REDIS_KEY_PREFIX=tixify:sec

# ------------------------------------------------------------------------------
# Postgres — security-owned tables only
# ------------------------------------------------------------------------------
# On serverless you MUST use a pooled connection string, otherwise each
# invocation opens its own connection and you will exhaust the connection limit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tixify
DATABASE_POOL_MAX=10

# Set to true on serverless/PgBouncer so the driver hands connections back
# immediately instead of holding them for the life of the invocation.
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# IP hashing (privacy) — audit logs store ipHash, never a raw IP address
# ------------------------------------------------------------------------------
# HMAC pepper. Rotating this makes historical ipHash values unlinkable.
IP_HASH_PEPPER=change-me-in-production

# ------------------------------------------------------------------------------
# Rate limiting — global defaults, overridable per endpoint
# ------------------------------------------------------------------------------
# These are DEFAULTS. The spec explicitly says not to hardcode the example
# values; everything here is configuration.
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST_LIMIT=40
RATE_LIMIT_WINDOW_SECONDS=1

# Per-endpoint policy overrides, format:
#   ENDPOINT_ROUTE=requests_per_second:burst_limit:window_seconds
# Example:
#   RATE_LIMIT_POLICY_AUTH=1:5:60
#   RATE_LIMIT_POLICY_RESERVATION=2:5:10
#   RATE_LIMIT_POLICY_PAYMENT=1:3:60
#   RATE_LIMIT_POLICY_TICKET_VERIFY=30:60:1
#   RATE_LIMIT_POLICY_EVENT_LISTING=50:100:1
#   RATE_LIMIT_POLICY_SEAT_AVAILABILITY=100:200:1

# What to do when Redis is unavailable. `true` = allow traffic through.
# Rate limiting fails OPEN on purpose: a Redis outage should not take the
# ticket drop offline. Signature verification and replay protection fail CLOSED.
RATE_LIMIT_FAIL_OPEN=true

# ------------------------------------------------------------------------------
# Idempotency
# ------------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400
# How long a duplicate request waits for the in-flight original to finish.
IDEMPOTENCY_WAIT_MS=2000

# ------------------------------------------------------------------------------
# Bot / automation protection
# ------------------------------------------------------------------------------
BOT_PROTECTION_ENABLED=true
# Score at which the pipeline escalates to challenge / restriction.
BOT_CHALLENGE_THRESHOLD=40
BOT_RESTRICT_THRESHOLD=80
BOT_SIGNAL_WINDOW_SECONDS=300
# Max reservations that may fail for one user before MULTIPLE_FAILED_BOOKINGS.
BOT_MAX_FAILED_BOOKINGS=5
# Max accounts creatable from one device/session fingerprint per window.
BOT_MAX_ACCOUNT_CREATION=3
BOT_TEMPORARY_RESTRICTION_SECONDS=900

# ------------------------------------------------------------------------------
# Virtual queue
# ------------------------------------------------------------------------------
QUEUE_ENABLED=true
# Active requests above this concurrency threshold trigger the queue.
QUEUE_MAX_CONCURRENT=2000
# Issued admission token lifetime. Short by design.
QUEUE_TOKEN_TTL_SECONDS=120
# Maximum tickets handed out per admission batch.
QUEUE_ADMISSION_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# Admin security dashboard
# ------------------------------------------------------------------------------
# Comma-separated admin user ids permitted to read /api/security/*.
# Authorization is enforced server-side; the frontend hiding links is irrelevant.
SECURITY_ADMIN_USER_IDS=

# ------------------------------------------------------------------------------
# Logging / observability
# ------------------------------------------------------------------------------
SECURITY_EVENT_BUFFER_SIZE=100
SECURITY_EVENT_FLUSH_INTERVAL_MS=2000
